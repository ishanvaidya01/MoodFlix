# MoodFlix environment variables
# Nothing here is required — the app runs with zero configuration.
# Copy this file to .env only if you want to override a default.
# Never commit .env.

# Optional: Express server port (defaults to 5000)
PORT=5000

# Optional: alternate URL for the MovieLens dataset zip
# MOODLENS_URL=https://files.grouplens.org/datasets/movielens/ml-latest-small.zip

# Optional: dataset directory (defaults to data/ml-latest-small)
# MOODFLIX_DATA_DIR=data/ml-latest-small

# Optional: model hyperparameters
# MF_FACTORS=16
# MF_EPOCHS=14

# Optional: SQLite favorites database path (defaults to favorites.db)
# MOODFLIX_DB=favorites.db

# Rate limit: requests per 60s window per IP (defaults to 120)
# RATE_LIMIT=120
